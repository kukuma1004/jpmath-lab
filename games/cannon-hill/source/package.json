{
  "name": "warureu-cannon-hill",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5212 --strictPort",
    "build": "tsc --noEmit && vite build",
    "build:publish": "npm run build && node scripts/publish.mjs",
    "build:online": "tsc --noEmit && node scripts/build-online.mjs",
    "start:online": "node online-dist/server.mjs",
    "check:online": "node scripts/check-online.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 5213 --strictPort",
    "test": "vitest run",
    "e2e": "playwright test",
    "bot": "vite-node scripts/bot.ts"
  },
  "dependencies": {
    "@firebase/app": "0.15.1",
    "@firebase/auth": "1.13.3",
    "@firebase/database": "1.1.3",
    "phaser": "3.90.0"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "typescript": "^5.9.3",
    "vite": "^7.2.2",
    "vite-node": "^3.2.4",
    "vitest": "^3.2.4"
  }
}
